def addCollisionObject(object_list):
    for object_ in object_list: # list of [Object] type
        mesh = object_.exo_mesh
        color = object_.color
        scene.add_object_to_environment(name="scene", color=(color[0], color[1], color[2], 1.0),
                shape=mesh,transform=exo.KDLFrame(object_.loc))


def visualiseGoal():
    pub = rospy.Publisher("target", MarkerArray, queue_size=1)
    sleep(0.5)
    msg = MarkerArray()
    m = Marker()
    m.header.frame_id = "exotica/world_frame"

    # m.type = Marker.SPHERE_LIST
    m.type = Marker.LINE_LIST
    m.pose.orientation.w = 0.0
    m.color.a = 1.0
    m.color.r = 1.0
    m.scale.x = 0.05
    for i in range(1, path_positions.shape[1]):
        m.points.append(Point(*path_positions[:, i - 1]))
        m.points.append(Point(*path_positions[:, i]))
    msg.markers.append(m)
    pub.publish(msg)

def randomize_joint_values(limits):
    n = limits.shape[0]
    joint_values = []
    for i in range(n):
        lower_limit, upper_limit = limits[i]
        joint_value = random.uniform(lower_limit, upper_limit)
        joint_values.append(joint_value)
    return joint_values

def figure_eight(t):
    return array([0.6, -0.1 + math.sin(t * 2.0 * math.pi * 0.5) * 0.1, 0.5 + math.sin(t * math.pi * 0.5) * 0.2])

