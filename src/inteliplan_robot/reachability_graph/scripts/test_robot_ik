    '{reachability_graph}/resources/exotica/hsrb/hsrb_ik.xml')
problem = solver.get_problem()
scene = problem.get_scene()
joint_limits = scene.get_kinematic_tree().get_joint_limits()
# joint_limits[0]=[-10,10]
# joint_limits[1]=[-10,10]
joint_limits = (np.asarray(joint_limits))/5 # avoid contorted poses
joint_limits[0]=[-10,10]
joint_limits[1]=[-10,10]
print(joint_limits)
print(scene.get_model_joint_names())
# print(len(scene.get_model_link_names()))
