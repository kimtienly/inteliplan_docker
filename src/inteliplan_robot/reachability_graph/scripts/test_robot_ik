# add collision to exotica scene
print('Adding collision scene..')
collision_objects = collision_object.CollisionObjectWrapper()
collision_objects.load_collision_objects(configuration.fixed_object_list_exotica)
addCollisionObject(collision_objects.objects_list)

print('Publishing IK')
signal.signal(signal.SIGINT, sig_int_handler)

i=0
# print(problem.get_cost_evolution()[1][-1])
# print('check_trajectory_continuous_time():',check_trajectory_continuous_time(scene,np.asarray([q1,q2])))
# print('check_whether_trajectory_is_collision_free_by_subsampling:',check_whether_trajectory_is_collision_free_by_subsampling(scene,np.asarray([q1,q2]),num_subsamples=100))
max_trials = 5
while True:
    try:
        cnt_trial = 0
        best_cost = 0
        best_q  = None

        problem.set_goal('Position', target_path[i])        
        # q_best = solver.solve()[0]
        while cnt_trial<max_trials:
            random_start = randomize_joint_values(joint_limits)

            # problem.start_state = random_start[:3] + [0]*12 + [random_start[3]] + [0]*2 + random_start[4:11] + [0]*8 + random_start[11:] + [0]*8 #pr2
            problem.start_state = random_start + [0]*21 #hsrb
            # problem.start_state = random_start[:3]+[0]*45
            q = solver.solve()[0]

            print(problem.get_scalar_cost())
            if best_cost==0 or best_cost>problem.get_scalar_cost():
                best_cost = problem.get_scalar_cost()
                q_best = q
                print(q)
            cnt_trial+=1
        print('best cost ',best_cost)
        publish_pose(q_best, problem)
        sleep(0.5)
        i+=1
        if i==len(target_path):
            i=0
    except KeyboardInterrupt:
        break
