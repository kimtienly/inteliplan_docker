<launch>

  <arg name="debug" default="false" />
  <arg unless="$(arg debug)" name="launch_prefix" value="" />
  <arg if="$(arg debug)" name="launch_prefix" value="xterm -e gdb -ex run --args python$(env ROS_PYTHON_VERSION)" />

  <param name="robot_description" textfile="$(find reachability_graph)/urdf/hsrb/hsrb.urdf" />
  <param name="robot_description_semantic" textfile="$(find reachability_graph)/urdf/hsrb/hsrb.srdf" />

  <node launch-prefix="$(arg launch_prefix)" pkg="reachability_graph" type="test_robot_ik" name="test_robot_ik_node" output="screen" />

  <node name="rviz" pkg="rviz" type="rviz" respawn="false"	args="-d $(find reachability_graph)/resources/test_robot.rviz" />
</launch>